# ─── Permionics BD Suite (API Server) — PRODUCTION Deployment Environment ──────
# This file documents every environment variable needed for a live deployment.
# Copy values from here into your hosting platform's environment variable settings
# (e.g. Railway, Render, Fly.io) — do NOT commit this file with real secrets.
# See local/deployment_guide.md for step-by-step instructions on where to get each value.
# ─────────────────────────────────────────────────────────────────────────────────

# ── 1. Execution Mode ─────────────────────────────────────────────────────────────
# Must be "deploy" in production. Controls debug logging, CORS strictness, etc.
APP_MODE=deploy

# ── 2. PostgreSQL Database (Neon, Supabase, Render Postgres, etc.) ────────────────
# Get this from your Neon/Supabase project dashboard under "Connection string".
# Format: postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# IMPORTANT: Always include ?sslmode=require for cloud PostgreSQL providers.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/permionics_db?sslmode=require

# ── 3. Firebase Auth (Production — NOT Emulator) ─────────────────────────────────
# In production, DO NOT set FIREBASE_AUTH_EMULATOR_HOST.
# Instead, set the full Firebase Service Account Key as a JSON string.
# See deployment_guide.md Section 3 for exact steps to download this from Firebase Console.
# IMPORTANT: The entire JSON must be on a single line (no line breaks).
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-...@your-project-id.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# ── 4. Authentication & Security ──────────────────────────────────────────────────
# ADMIN_EMAIL: The master admin login email for the Permionics team.
ADMIN_EMAIL=admin@permionics.com

# ADMIN_PASSWORD: The shared team admin password. Change this to a strong password.
ADMIN_PASSWORD=ChangeThisToAStrongPassword@2026!

# SESSION_SECRET: A long random secret string (min 32 chars) used to sign JWT session cookies.
# Generate one at: https://www.uuidgenerator.net/ or run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_this_with_a_long_random_secret_at_least_48_chars_long

# ── 5. Server Port & CORS ─────────────────────────────────────────────────────────
# PORT: Your hosting platform sets this automatically. Leave as 5000 if self-hosting.
PORT=5000

# CORS_ORIGIN: The exact URL of your deployed frontend (no trailing slash).
# Example: https://permionics-bd-suite.vercel.app
CORS_ORIGIN=https://YOUR_FRONTEND_URL

# ── 6. Cloudflare R2 Object Storage CDN (Required for image uploads in Generator) ──
# See deployment_guide.md Section 5 for how to create a Cloudflare R2 bucket and get keys.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=permionics-assets
R2_PUBLIC_URL=https://pub-XXXXXXXXXXXXXXXX.r2.dev

# ── 7. Osmos AI RAG Engines (Optional but Strongly Recommended) ───────────────────
# If left empty, the system falls back to the Smart Context Synthesizer (no LLM).
# GROQ: Primary LLM engine. Free tier available at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# GEMINI: Fallback LLM + Vision OCR for scanned PDFs. Free tier at https://aistudio.google.com
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
