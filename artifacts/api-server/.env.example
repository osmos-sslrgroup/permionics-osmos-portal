# ─── Permionics BD Suite (API Server) — Environment Variables ─────────────────
# Copy this file to .env inside artifacts/api-server/
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. Execution Mode Engine ─────────────────────────────────────────────────
# Operation mode: debug | test | deploy
APP_MODE=debug

# ── 2. Standard PostgreSQL Database (pgAdmin / Local / Neon) ─────────────────
# Format: postgres://username:password@localhost:5432/permionics_db
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/permionics_db

# ── 3. Firebase Auth Local Emulator Host ─────────────────────────────────────
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_PROJECT_ID=demo-permionics

# ── 4. Authentication & Security Credentials ──────────────────────────────────
ADMIN_EMAIL=admin@permionics.com
ADMIN_PASSWORD=Permionics@2026!
SESSION_SECRET=permionics_local_secret_key_2026_at_least_32_chars

# ── 5. Server Port & CORS ────────────────────────────────────────────────────
PORT=5000
CORS_ORIGIN=http://localhost:5173

# ── 6. Cloudflare R2 Object Storage CDN (Optional) ───────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ── 7. Osmos AI RAG Engines (Optional) ───────────────────────────────────────
GROQ_API_KEY=
GEMINI_API_KEY=
