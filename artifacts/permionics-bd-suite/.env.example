# ─── Permionics BD Suite (Frontend App) — Environment Variables ───────────────
# Copy this file to .env inside artifacts/permionics-bd-suite/
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. Firebase Local Auth Emulator Suite ─────────────────────────────────────
# Set to true to connect frontend to local Firebase Auth Emulator at 127.0.0.1:9099
VITE_USE_FIREBASE_EMULATOR=true
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1:9099

# ── 2. Firebase Client App Credentials (https://console.firebase.google.com) ──
# (These demo values are automatically used when running the local Firebase emulator)
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=127.0.0.1
VITE_FIREBASE_PROJECT_ID=demo-permionics
VITE_FIREBASE_STORAGE_BUCKET=demo-permionics.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:demo
