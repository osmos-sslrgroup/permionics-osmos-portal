# ─── Permionics BD Suite (OSMOS) — Environment Variables ──────────────────────
# Copy this file to .env and fill in your real values.
# .env is gitignored — it will NEVER be pushed to GitHub.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (Database & Object Storage CDN) ──────────────────────────────────
# Required for production persistence. If omitted, app defaults to zero-config local mock mode.
# Get these from: https://app.supabase.com → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=eyJ...your-service-role-key...

# ── Osmos AI RAG Engines (Groq & Google Gemini Failover) ──────────────────────
# Primary AI Engine (Groq Llama-3 70B Versatile): https://console.groq.com/keys
GROQ_API_KEY=gsk_...
# Secondary AI Engine & PDF Vision OCR (Google Gemini 2.5/2.0/1.5 Flash): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...

# ── Authentication & Security ────────────────────────────────────────────────
# Admin Email for Master Admin Login
ADMIN_EMAIL=admin@permionics.com

# Shared Admin Master Password for team login
ADMIN_PASSWORD=your-team-password-here

# Secret key used to sign secure JWT httpOnly session cookies (32+ chars)
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# ── Server & CORS ────────────────────────────────────────────────────────────
# API Server port (default: 5000)
PORT=5000

# CORS Allowed Origin for production deployment (e.g. https://permionics-bd.vercel.app)
CORS_ORIGIN=https://your-frontend-app.vercel.app

# ── Firebase Google Auth & User Management ──────────────────────────
# Get these from: https://console.firebase.google.com → Project Settings
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abc123def456

# Firebase Admin SDK credentials (for Backend user management)
# From Project Settings -> Service Accounts -> Generate New Private Key (Download JSON, minify to 1 line, and paste here)
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}
