# ─── Permionics BD Suite (OSMOS) — Environment Variables ──────────────────────
# Copy this file to .env and fill in your real values.
# .env is gitignored — it will NEVER be pushed to GitHub.
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. Execution Mode Engine ─────────────────────────────────────────────────
# Operation mode: debug | test | deploy
# - debug:  Detailed line-by-line SQL parameter logging and Osmos AI RAG tracing
# - test:   Runs automated test suite runner
# - deploy: Strict production readiness validation (requires DATABASE_URL, SESSION_SECRET)
APP_MODE=debug

# ── 2. Standard PostgreSQL Database (pgAdmin / Neon / Railway / Local) ───────────
# Required for production persistence. If omitted, app operates in zero-config local mock mode.
# Format: postgres://username:password@localhost:5432/permionics_db
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/permionics_db

# ── 3. Cloudflare R2 Object Storage CDN (Photo & Image Uploads) ───────────────
# Optional: Used for uploading Plant, Partnership, and Beaker photos.
# If omitted, uploads automatically save to local server disk storage (/uploads/).
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=auto
S3_PUBLIC_URL=

# ── 4. Osmos AI RAG Engines (Groq & Google Gemini Failover) ───────────────────
# Primary AI Engine (Groq Llama-3 70B Versatile): https://console.groq.com/keys
GROQ_API_KEY=

# Secondary AI Engine & PDF Vision OCR (Google Gemini 2.5/2.0/1.5 Flash): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── 5. Authentication & Master Admin Credentials ──────────────────────────────
# Admin Email for Master Admin Account Sync
ADMIN_EMAIL=admin@permionics.com

# Shared Master Admin Password for initial initialization
ADMIN_PASSWORD=Permionics@2026!

# Secret key used to sign secure JWT httpOnly session cookies (32+ chars)
SESSION_SECRET=permionics_local_secret_key_2026_at_least_32_chars

# ── 6. Server & CORS Settings ────────────────────────────────────────────────
# API Server port (default: 5000)
PORT=5000

# CORS Allowed Origin for production deployment (e.g. https://permionics-bd.vercel.app)
CORS_ORIGIN=http://localhost:5173

# ── 7. Firebase Auth & Local Emulator Suite ──────────────────────────────────
# Local Emulator Toggle (Set to true to connect frontend to local Firebase Auth Emulator at 127.0.0.1:9099)
VITE_USE_FIREBASE_EMULATOR=true
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1:9099

# Backend Firebase Auth Emulator Host
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_PROJECT_ID=demo-permionics

# Production Firebase Client Web Credentials (https://console.firebase.google.com)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Production Firebase Admin SDK Credentials (Minified JSON service account key)
FIREBASE_SERVICE_ACCOUNT_KEY=
